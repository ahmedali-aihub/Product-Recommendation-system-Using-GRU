MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=product_recommender
MYSQL_USER=recommender_app
MYSQL_PASSWORD=changeme

# Only needed when connecting to a cloud MySQL provider that requires SSL
# (e.g. Aiven) -- path to a downloaded CA cert. Leave unset for local dev.
# MYSQL_SSL_CA=db/aiven-ca.pem

# Comma-separated list of origins allowed to call the API (CORS). Only
# needed in production -- defaults to the local Vite dev server if unset.
# FRONTEND_ORIGINS=https://your-app.vercel.app

# Free key from pexels.com/api -- only needed to run
# app/scripts/fetch_product_images.py (a one-time asset-prep script)
PEXELS_API_KEY=changeme
