models/gru4rec_prototype.weights.h5

# python
__pycache__/
*.pyc
.venv/
venv/

# db bulk-load logs
db/load_output.log

# scratch run logs (training/install/eval output redirected to a file)
*.log

# frontend
app/node_modules/
app/dist/

# scratch artifacts (temp code bundle for Colab, not source)
src.zip

# local Claude Code session data, not meant for the public repo
.claude/
